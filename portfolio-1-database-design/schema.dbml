// Crestfield University – Student Result Portal
// MIT 8103 Portfolio 1: ER model

Table faculty {
  faculty_id int [pk]
  faculty_name string [unique, not null]
}

Table department {
  department_id int [pk]
  faculty_id int [not null, ref: > faculty.faculty_id]          // contains
  department_name string [not null]
}

Table programme {
  programme_id int [pk]
  department_id int [not null, ref: > department.department_id] // offers
  programme_name string [not null]
  award_type string
  maximum_level int
}

Table academic_session {
  session_id int [pk]
  session_name string [unique, not null]
  start_date date
  end_date date
}

Table semester {
  semester_id int [pk]
  session_id int [not null, ref: > academic_session.session_id] // contains
  semester_name string [not null]
  start_date date
  end_date date

  indexes {
    (session_id, semester_name) [unique] // added
  }
}

Table user_account {
  user_id int [pk]
  email string [unique, not null]
  password_hash string [not null]
  account_status string
  role string [not null]
}

Table student {
  student_id int [pk]
  programme_id int [not null, ref: > programme.programme_id]        // admits
  user_id int [unique, ref: - user_account.user_id]                 // owns (1:1)
  entry_session_id int [ref: > academic_session.session_id]         // entry_session
  matric_number string [unique, not null]
  first_name string [not null]
  last_name string [not null]
  admission_date date
  current_level int
  student_status string
}

Table lecturer {
  lecturer_id int [pk]
  department_id int [not null, ref: > department.department_id]     // employs
  user_id int [unique, ref: - user_account.user_id]                 // owns (1:1)
  staff_number string [unique, not null]
  first_name string [not null]
  last_name string [not null]
}

Table course {
  course_id int [pk]
  department_id int [not null, ref: > department.department_id]     // owns
  assigned_lecturer_id int [ref: > lecturer.lecturer_id]            // currently_teaches
  course_code string [unique, not null]
  course_title string [not null]
  credit_unit int [not null]
}

Table programme_course {
  programme_course_id int [pk]
  programme_id int [not null, ref: > programme.programme_id]        // includes
  course_id int [not null, ref: > course.course_id]                 // assigned_to
  study_level int
  course_type string

  indexes {
    (programme_id, course_id) [unique] // added
  }
}

Table course_registration {
  registration_id int [pk]
  student_id int [not null, ref: > student.student_id]              // registers
  course_id int [not null, ref: > course.course_id]                 // registered_for
  semester_id int [not null, ref: > semester.semester_id]           // occurs_in
  attempt_number int [not null]
  registration_status string
  registration_date date

  indexes {
    (student_id, course_id, attempt_number) [unique] // added
  }
}

Table grade_scale {
  grade_id int [pk]
  grade string [unique, not null]
  minimum_score decimal [not null]
  maximum_score decimal [not null]
  grade_point decimal [not null]
}

Table result {
  result_id int [pk]
  registration_id int [unique, not null, ref: - course_registration.registration_id] // receives (1:1)
  ca_score decimal
  exam_score decimal
  total_score decimal
  grade_id int [ref: > grade_scale.grade_id]                        // determines_grade
  result_date date
}

Table lecturer_assignment_history {
  history_id int [pk]
  course_id int [not null, ref: > course.course_id]                 // assignment_history
  lecturer_id int [not null, ref: > lecturer.lecturer_id]           // assignment_history
  effective_from date [not null]
  effective_to date
  changed_by_user_id int [ref: > user_account.user_id]              // records_change
}

Table grade_change_log {
  log_id int [pk]
  result_id int [not null, ref: > result.result_id]                 // has_changes
  changed_by_user_id int [not null, ref: > user_account.user_id]    // records_change
  old_ca_score decimal
  new_ca_score decimal
  old_exam_score decimal
  new_exam_score decimal
  change_timestamp datetime [not null]
  change_reason string
}
